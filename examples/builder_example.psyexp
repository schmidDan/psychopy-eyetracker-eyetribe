<?xml version="1.0" encoding="utf-8"?>
<!--
  Eye Tribe Builder example for psychopy-eyetracker-eyetribe.

  Open in PsychoPy 2026.1.3 Builder. The experiment:
    1. Runs the Eye Tribe 9-point calibration (via Eyetracker component).
    2. Presents a fixation cross for 2 s while recording gaze.
    3. Writes gaze events to the PsychoPy data file.

  Prerequisites:
    - psychopy-eyetracker-eyetribe installed (pip install <wheel>).
    - Eye Tribe Server running at 127.0.0.1:6555.
    - ET1000 connected and trackerstate = 0.
-->
<PsychoPy2experiment encoding="utf-8" version="2026.1.3">
  <Settings>
    <Param val="eye_tribe_builder_example" valType="str" updates="None" name="expName"/>
    <Param val="2026.1.3" valType="str" updates="None" name="psychopyVersion"/>
    <Param val="use prefs" valType="str" updates="None" name="audioLib"/>
    <Param val="use prefs" valType="str" updates="None" name="audioDevice"/>
    <Param val="use prefs" valType="str" updates="None" name="audioLatencyMode"/>
    <Param val="False" valType="bool" updates="None" name="Save hdf5 file"/>
    <Param val="True" valType="bool" updates="None" name="Save wide csv file"/>
    <Param val="True" valType="bool" updates="None" name="Save psydat file"/>
    <Param val="True" valType="bool" updates="None" name="Save excel file"/>
    <Param val="True" valType="bool" updates="None" name="Save log file"/>
    <Param val="warning" valType="str" updates="None" name="Logging level"/>
    <Param val="0" valType="code" updates="None" name="Monitor"/>
    <Param val="testMonitor" valType="str" updates="None" name="Monitor"/>
    <Param val="[1920, 1080]" valType="list" updates="None" name="Window size (pixels)"/>
    <Param val="True" valType="bool" updates="None" name="Full-screen window"/>
    <Param val="1" valType="num" updates="None" name="Screen"/>
    <Param val="norm" valType="str" updates="None" name="Units"/>
    <Param val="False" valType="bool" updates="None" name="Flip horizontal"/>
    <Param val="False" valType="bool" updates="None" name="Flip vertical"/>
    <Param val="none" valType="str" updates="None" name="color"/>
    <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
    <!-- Eye Tribe eyetracker configuration -->
    <Param val="eyetracker.hw.eyetribe.EyeTracker" valType="str" updates="None" name="eyeTracker"/>
    <Param val="127.0.0.1" valType="str" updates="None" name="etHost"/>
    <Param val="6555" valType="num" updates="None" name="etPort"/>
    <Param val="'raw'" valType="str" updates="None" name="etGazeSource"/>
    <Param val="9" valType="num" updates="None" name="etCalibTargetCount"/>
  </Settings>
  <Routines>
    <Routine name="trial">
      <TextComponent name="fixation">
        <Param val="white" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="norm" valType="str" updates="None" name="units"/>
        <Param val="" valType="str" updates="constant" name="flip"/>
        <Param val="0.1" valType="num" updates="constant" name="letterHeight"/>
        <Param val="fixation" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0" valType="num" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="2" valType="num" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="+" valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
    </Routine>
  </Routines>
  <Flow>
    <Routine name="trial"/>
  </Flow>
</PsychoPy2experiment>
